generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cellar {
  id              String       @id @default(cuid())
  userId          String       @default("")
  name            String
  location        String?
  backgroundImage String?
  createdAt       DateTime     @default(now())
  stockItems      StockItem[]
  withdrawals     Withdrawal[]
}

model Wine {
  id          String       @id @default(cuid())
  userId      String       @default("")
  producer    String
  name        String
  vintage     Int?
  region      String?
  country     String?
  vivinoUrl   String?
  notes       String?
  labelImage  String?
  userRating  Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stockItems  StockItem[]
  vivinoData  VivinoData?
  grapes      WineGrape[]
  withdrawals Withdrawal[]
}

model Grape {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  wines     WineGrape[]
}

model WineGrape {
  wineId  String
  grapeId String
  wine    Wine  @relation(fields: [wineId], references: [id], onDelete: Cascade)
  grape   Grape @relation(fields: [grapeId], references: [id], onDelete: Cascade)

  @@id([wineId, grapeId])
}

model StockItem {
  id            String   @id @default(cuid())
  wineId        String
  cellarId      String
  quantity      Int      @default(1)
  purchasePrice Float?
  binLocation   String?
  drinkFrom     Int?
  drinkUntil    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  wine          Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  cellar        Cellar   @relation(fields: [cellarId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id            String   @id @default(cuid())
  wineId        String
  cellarId      String
  quantity      Int
  reason        String?
  observation   String?
  wouldBuyAgain Boolean?
  withdrawnAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  wine          Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
  cellar        Cellar   @relation(fields: [cellarId], references: [id], onDelete: Cascade)
}

model VivinoData {
  id             String   @id @default(cuid())
  wineId         String   @unique
  score          Float?
  reviewCount    Int?
  wineStyle      String?
  foodPairings   String?
  description    String?
  tasteBody      Float?
  tasteTannins   Float?
  tasteAcidity   Float?
  tasteSweetness Float?
  tasteFizziness Float?
  flavorNotes    String?
  fetchedAt      DateTime @default(now())
  wine           Wine     @relation(fields: [wineId], references: [id], onDelete: Cascade)
}
